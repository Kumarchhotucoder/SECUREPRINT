# ========================================
# SecurePrint Environment Configuration
# ========================================
# Copy this file to .env and fill in values
# NEVER commit .env to version control

# Server
NODE_ENV=production
PORT=5001
CLIENT_URL=https://your-domain.com

# Canonical Public App URL for Permanent Shop QR (Never localhost in production)
PUBLIC_APP_URL=https://your-domain.com
APP_BASE_URL=https://your-domain.com

# Database
MONGODB_URI=mongodb://localhost:27017/secureprint
# or DATABASE_URL=mongodb+srv://user:pass@cluster.mongodb.net/secureprint

# Authentication & JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Payment Gateways (Razorpay)
RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# File Storage & Limits
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
STORAGE_URL=
STORAGE_KEY=

# Auto-Cleanup & Lifecycle
DELETION_DELAY_MS=10000
SESSION_EXPIRY_HOURS=4

# Initial Super Admin Seed
ADMIN_EMAIL=admin@secureprint.in
ADMIN_PASSWORD=ChangeThisSecurePassword123!

